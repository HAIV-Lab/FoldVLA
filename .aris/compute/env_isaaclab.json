{
  "base": "cuda12.8 + python3.11",
  "system_pkgs": [],
  "pip_phases": [
    ["torch==2.7.0+cu128", "torchvision==0.22.0", "torchaudio==2.7.0"],
    ["isaacsim[all,extscache]==5.1.0"],
    ["isaaclab==2.3.0 (local editable)"],
    ["sharpawave-rl-lab (local editable)"]
  ],
  "env": {
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID"
  },
  "run_commands": [],
  "weight_dirs": {},
  "smoke": {
    "import_names": ["torch", "isaaclab", "rl_isaaclab"],
    "gpu_tests": [
      {
        "cmd": "python -u rl_isaaclab/scripts/test_north_poc2_2_asset.py --headless --device cuda:3 --disable_collisions --fast_exit --steps 20",
        "expect": "^PHYSICS_WITNESS steps=20 .* finite=True$"
      }
    ],
    "cli_checks": ["nvidia-smi"]
  }
}
